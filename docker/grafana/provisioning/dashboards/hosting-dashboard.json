{
  "dashboard": {
    "id": null,
    "title": "Hosting Control Panel - System Overview",
    "tags": ["hosting", "infrastructure"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 0,
    "panels": [
      {
        "id": 1,
        "title": "Active Nodes",
        "type": "stat",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "red", "value": null},
                {"color": "green", "value": 1}
              ]
            }
          }
        },
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto",
          "orientation": "horizontal",
          "reduceOptions": {
            "calcs": ["lastNotNull"],
            "fields": "",
            "values": false
          },
          "textMode": "auto"
        },
        "targets": [
          {
            "expr": "count(up{job='hosting-api'} == 1)",
            "legendFormat": "Active Nodes",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 4,
          "x": 0,
          "y": 0
        }
      },
      {
        "id": 2,
        "title": "Total Websites",
        "type": "stat",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "orange", "value": 100},
                {"color": "red", "value": 500}
              ]
            }
          }
        },
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto",
          "orientation": "horizontal",
          "reduceOptions": {
            "calcs": ["lastNotNull"],
            "fields": "",
            "values": false
          },
          "textMode": "auto"
        },
        "targets": [
          {
            "expr": "sum(hosting_websites_total)",
            "legendFormat": "Total Websites",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 4,
          "x": 4,
          "y": 0

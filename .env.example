# Hosting Control Panel - Environment Configuration
# Copy this file to .env and adjust values for your environment

# Application
APP_NAME=Hosting Control Panel
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# JWT Authentication
JWT_SECRET_KEY=change-me-in-production-use-a-strong-random-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption
ENCRYPTION_KEY=change-me-in-production-use-a-strong-encryption-key-32bytes

# PostgreSQL Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hosting_control
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=/data/storage
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_MINIO_ENDPOINT=
STORAGE_MINIO_ACCESS_KEY=
STORAGE_MINIO_SECRET_KEY=

# Backup
BACKUP_LOCAL_PATH=/data/backups
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 3 * * *

# Monitoring
MONITORING_ENABLED=true
MONITORING_INTERVAL_SECONDS=30
MONITORING_ALERT_CPU_THRESHOLD=90.0
MONITORING_ALERT_RAM_THRESHOLD=90.0
MONITORING_ALERT_DISK_THRESHOLD=85.0
MONITORING_ALERT_EMAIL=admin@example.com

# Node Agent
NODE_HEARTBEAT_INTERVAL=30
NODE_HEARTBEAT_TIMEOUT=120
NODE_SSH_TIMEOUT=30
NODE_DOCKER_TIMEOUT=60

# Hosting
HOSTING_BASE_PATH=/hosting
HOSTING_DEFAULT_PHP_VERSION=8.3
HOSTING_DEFAULT_MYSQL_VERSION=8.0
HOSTING_DEFAULT_REDIS_VERSION=7.2

# SSL
SSL_EMAIL=admin@example.com
SSL_RENEW_BEFORE_DAYS=30

# Security
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Sentry
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# OpenTelemetry
OTLP_ENDPOINT=
OTLP_SERVICE_NAME=hosting-control-panel